{
  "name": "@tx5dr/server",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./DigitalRadioEngine": "./dist/DigitalRadioEngine.js",
    "./cpu-profile": "./dist/services/ServerCpuProfileManager.js",
    "./build-info.json": "./dist/generated/buildInfo.json"
  },
  "scripts": {
    "build": "node ../../scripts/clean-paths.mjs dist && tsc",
    "dev": "node ../../scripts/run-with-env.mjs --node-env=development tsx watch --watch-path=src --include='../builtin-plugins/dist/**/*.js' --include='../core/dist/**/*.js' src/index.ts",
    "dev:prof": "node ../../scripts/run-with-env.mjs --node-env=development tsx --prof src/index.ts",
    "dev:check-native": "tsx src/scripts/check-native-modules.ts",
    "start": "node ../../scripts/run-with-env.mjs node dist/scripts/server-launcher.js dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "yarn test:unit && yarn test:logbook-performance",
    "test:unit": "vitest run --pool=forks --maxWorkers=2 --exclude 'src/**/*.performance.test.ts'",
    "test:logbook-performance": "vitest run --pool=forks src/log/__tests__/ADIFLogProvider.performance.test.ts --maxWorkers=1",
    "test:station-integration": "vitest run --pool=forks src/simulation/PeerSession.performance.test.ts src/radio/__tests__/HamlibConnection.dummy.performance.test.ts src/radio/__tests__/HamlibConnection.network.performance.test.ts src/decode/__tests__/WSJTXDecodeSession.performance.test.ts --maxWorkers=1",
    "profile:cpu": "yarn build && node --cpu-prof dist/index.js",
    "profile:heap": "yarn build && node --heap-prof dist/index.js"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.1.0",
    "@openwebrx-js/api": "0.1.7",
    "@tx5dr/builtin-plugins": "workspace:*",
    "@tx5dr/contracts": "workspace:*",
    "@tx5dr/core": "workspace:*",
    "@tx5dr/plugin-api": "workspace:*",
    "@tx5dr/rigctld-server": "workspace:*",
    "@types/ws": "^8.18.1",
    "audify": "patch:audify@npm%3A1.10.1#~/.yarn/patches/audify-npm-1.10.1-076cc4cf40.patch",
    "bcrypt": "^6.0.0",
    "eventemitter3": "^5.0.1",
    "fast-jwt": "^6.3.6",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "hamlib": "0.7.7",
    "icom-wlan-node": "0.8.1",
    "node-datachannel": "0.32.3",
    "node-wav": "^0.0.2",
    "onnxruntime-node": "^1.26.0",
    "pngjs": "^7.0.0",
    "rasterwave-node": "0.6.0",
    "rubato-fft-node": "^0.2.0",
    "serialport": "^13.0.0",
    "tci-client-node": "https://github.com/boybook/tci-client-node.git#commit=7359e718e4b0efe97ef7e2172754b397c36a6b16",
    "wsjtx-lib": "2.2.0",
    "xstate": "^5.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@statelyai/inspect": "^0.7.2",
    "@tx5dr/shared-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/node-wav": "^0",
    "@types/pngjs": "^6.0.5",
    "autocannon": "^8.0.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
