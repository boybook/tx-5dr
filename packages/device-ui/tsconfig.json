{
  "extends": "../shared-config/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2021"],
    "noEmit": false,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "declarationDir": "dist",
    "module": "ESNext",
    "target": "ES2021",
    "types": ["node"],
    "isolatedModules": false
  },
  "include": ["src/**/*"]
}
