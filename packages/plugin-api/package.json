{
  "name": "@tx5dr/plugin-api",
  "version": "2.3.0",
  "type": "module",
  "description": "Public plugin API for TX-5DR digital radio engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boybook/tx-5dr",
    "directory": "packages/plugin-api"
  },
  "keywords": [
    "tx5dr",
    "plugin",
    "ham-radio",
    "ft8",
    "digital-radio"
  ],
  "files": [
    "dist",
    "src/bridge.d.ts",
    "tokens.css"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./toolkit": {
      "import": "./dist/toolkit/index.js",
      "require": "./dist/toolkit/index.js",
      "types": "./dist/toolkit/index.d.ts"
    },
    "./contest": {
      "import": "./dist/toolkit/contest/index.js",
      "require": "./dist/toolkit/contest/index.js",
      "types": "./dist/toolkit/contest/index.d.ts"
    },
    "./contest-logbook-ui/*": "./dist/contest-logbook-ui/*",
    "./bridge": {
      "types": "./src/bridge.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && npx vite build --config contest-logbook-ui/vite.config.ts",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run --passWithNoTests",
    "smoke:pack": "node scripts/packed-consumer-smoke.mjs"
  },
  "dependencies": {
    "@tx5dr/contracts": "workspace:*",
    "@tx5dr/core": "workspace:*",
    "@types/node": "^20.11.24"
  },
  "devDependencies": {
    "@tx5dr/shared-config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0",
    "vite": "^6.3.4",
    "vitest": "^1.0.0"
  }
}
